# Copy to .env and fill in. .env is gitignored.

# Prisma / SQLite database location
DATABASE_URL="file:./dev.db"

# Account Map data source.
# Leave UNSET in local dev to use the bundled non-sensitive sample
# (data/account-map-sample.csv).
# In production, point this at the REAL customer file stored OUTSIDE the repo,
# readable only by the app's service account (e.g. chmod 600). See
# docs/account-data-security.md.
# ACCOUNT_DATA_FILE=/etc/se-deal-workspace/accounts.csv

# LLM for the Note Formatter (standard OpenAI-compatible /chat/completions API).
# Point LLM_BASE_URL at the endpoint base (everything up to and including /v1;
# the app appends /chat/completions and /models itself).
# Examples:
#   Nutanix Enterprise AI -> https://ai.nutanix.com/enterpriseai/v1
#   Ollama                -> http://localhost:11434/v1
#   LM Studio             -> http://localhost:1234/v1
# Leave UNSET to disable the AI path (the Note Formatter still works offline).
# LLM_BASE_URL=https://ai.nutanix.com/enterpriseai/v1
# Model name your endpoint serves (ask your admin or check GET <base>/models).
# LLM_MODEL=
# Bearer token / API key (sent as Authorization: Bearer <key>).
# LLM_API_KEY=
# Optional: override the default Note Formatter system prompt.
# LLM_SYSTEM_PROMPT=
# Request timeout in milliseconds (default 60000).
# LLM_TIMEOUT_MS=60000
# Set to true ONLY for internal endpoints with a self-signed cert (curl -k).
# Relaxes TLS verification for this endpoint only, not the whole process.
# LLM_INSECURE_TLS=false
