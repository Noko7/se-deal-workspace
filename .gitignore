# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Sensitive customer data — NEVER commit real account data.
# Only the non-sensitive data/account-map-sample.csv is tracked.
/secure-data/
/data/*.csv
!/data/account-map-sample.csv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite databases
/dev.db
/prisma/dev.db
