# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local admin config (connector status, encrypted LLM credentials)
/data/local-config.json

# Customer reference material lives in /docs and must never reach the remote:
# Collector / RVTools / LiveOptics exports contain real estate inventory, even
# when masked. Only the hand-written .md notes are tracked.
/docs/**
!/docs/*.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
