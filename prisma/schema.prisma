generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum IntegrationStatus {
  NOT_CONNECTED
  NEEDS_ATTENTION
  CONNECTED
}

enum AssetType {
  PRESENTATION
  COLLECTOR
  RV_TOOL
  ZIP_BUNDLE
  WHITEBOARD
  TEXT_BRIEF
  QBR_REPORT
}

enum PreviewStatus {
  READY
  PENDING
  FAILED
}

enum RecommendationDecision {
  PENDING
  APPROVED
  REJECTED
}

enum QBRItemStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum NoteRole {
  SE
  AE
  SAM
}

// Application user for the login / signup flow. Passwords are stored as a
// scrypt hash (see src/lib/auth.ts); the plaintext is never persisted.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Deal {
  id                  String                @id @default(cuid())
  name                String
  accountName         String
  stage               String
  owner               String
  nextAction          String
  latestSignal        String?
  amount              Float                 @default(0)
  technicalCloseStatus String               @default("-")
  closeDate           DateTime?
  isClosed            Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  meetings            Meeting[]
  assets              MeetingAsset[]
  emails              DealEmail[]
  context             CustomerContext[]
  requirements        EnvironmentRequirement[]
  recommendations     SizingRecommendation[]
  qbrArtifacts        QBRArtifact[]
  qbrChecklistItems   QBRChecklistItem[]
  notes               MeetingNote[]
  transcripts         MeetingTranscript[]
}

model Meeting {
  id              String            @id @default(cuid())
  source          String
  subject         String
  organizer       String
  startTime       DateTime
  endTime         DateTime
  attendeesJson   String
  externalDomains String
  joinUrl         String?
  location        String?
  dealId          String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deal            Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assets          MeetingAsset[]
  contexts        CustomerContext[]
  notes           MeetingNote[]
  transcript      MeetingTranscript?

  @@index([dealId])
}

model IntegrationConnection {
  id                String            @id @default(cuid())
  integrationKey    String            @unique
  displayName       String
  status            IntegrationStatus @default(NOT_CONNECTED)
  connectedBy       String?
  connectedAt       DateTime?
  lastHealthCheckAt DateTime?
  setupNotes        String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// Singleton record for LLM connection settings configured from the Integrations
// page. The API key is encrypted at rest before being stored.
model LlmCredential {
  id               String   @id @default(cuid())
  singleton        String   @unique @default("default")
  baseUrl          String
  model            String
  apiKeyCiphertext String?
  timeoutMs        Int      @default(60000)
  insecureTls      Boolean  @default(false)
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Singleton config for the Zoom connector (set on the Integrations page). It
// controls whether Zoom meeting notes, the AI summary, and the full transcript
// are auto-attached to the matching meeting and fed to Account-AI and the Note
// Formatter. The webhook verification secret is encrypted at rest.
model ZoomConfig {
  id                      String   @id @default(cuid())
  singleton               String   @unique @default("default")
  enabled                 Boolean  @default(false)
  accountId               String?
  autoAttachNotes         Boolean  @default(true)
  autoAttachSummary       Boolean  @default(true)
  autoAttachTranscript    Boolean  @default(true)
  feedAccountAi           Boolean  @default(true)
  feedNoteFormatter       Boolean  @default(true)
  webhookSecretCiphertext String?
  updatedBy               String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Zoom-sourced artifacts for one meeting: the AI summary, the full transcript,
// and any meeting notes. One row per meeting; updated in place on re-ingest.
// Account-AI and the Opportunity view read this as a first-class note source.
model MeetingTranscript {
  id             String   @id @default(cuid())
  meetingId      String   @unique
  dealId         String
  source         String   @default("zoom")
  summary        String?
  transcript     String?
  notes          String?
  autoIngestedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  meeting        Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model MeetingAsset {
  id                   String        @id @default(cuid())
  meetingId            String?
  dealId               String
  type                 AssetType
  source               String
  sourceTool           String
  title                String
  uri                  String
  uploadedBy           String
  previewImageUri      String?
  previewStatus        PreviewStatus @default(PENDING)
  previewLastUpdatedAt DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  meeting              Meeting?      @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  deal                 Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([meetingId])
}

model DealEmail {
  id             String   @id @default(cuid())
  dealId         String?
  threadId       String
  messageId      String
  subject        String
  from           String
  body           String
  receivedAt     DateTime
  assignedBy     String?
  assignedAt     DateTime?
  summary        String?
  extractedJson  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deal           Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([dealId])
}

model QBRArtifact {
  id                   String   @id @default(cuid())
  dealId               String
  accountName          String
  source               String
  fileUri              String
  generatedAt          DateTime
  uploadedBy           String
  guideChecklistVersion String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deal                 Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model QBRChecklistItem {
  id                   String        @id @default(cuid())
  dealId               String
  sectionKey           String
  title                String
  status               QBRItemStatus @default(TODO)
  notes                String
  recommendedTalkTrack String
  lastUpdatedAt        DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deal                 Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model CustomerContext {
  id                 String   @id @default(cuid())
  meetingId          String?
  dealId             String
  customerCandidates String
  notes              String
  openDeals          String
  sizerRuns          String
  confidenceScore    Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  meeting            Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  deal               Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([meetingId])
}

model EnvironmentRequirement {
  id                   String   @id @default(cuid())
  dealId               String
  rawText              String
  extractedConstraints String
  prerequisites        String
  restrictions         String
  workloadHints        String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deal                 Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model SizingRecommendation {
  id                  String                 @id @default(cuid())
  dealId              String
  inputRequirementIds String
  suggestedConfig     String
  ruleMatches         String
  riskFlags           String
  confidenceScore     Float
  decision            RecommendationDecision @default(PENDING)
  decisionNotes       String?
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deal                Deal                   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model MeetingNote {
  id         String   @id @default(cuid())
  dealId     String
  meetingId  String?
  role       NoteRole @default(SE)
  author     String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  meeting    Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([meetingId])
}

model ContextEvidence {
  id           String   @id @default(cuid())
  sourceSystem String
  sourceId     String
  lastSyncedAt DateTime
  confidenceReason String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
